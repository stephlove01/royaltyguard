# Server
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=royaltyguard
DB_USER=root
DB_PASSWORD=

# Authentication
JWT_SECRET=replace_with_a_secure_secret

# File uploads
UPLOAD_DIR=uploads

# n8n
N8N_WEBHOOK_SECRET=replace_with_n8n_webhook_secret
N8N_STATEMENT_ARTIST_ID=
N8N_BASE_URL=http://localhost:5678

# Dispute email delivery (n8n webhook that sends through Gmail after user approval).
N8N_DISPUTE_SEND_WEBHOOK_URL=
# AI dispute draft webhook (n8n Gemini draft workflow).
N8N_DISPUTE_DRAFT_WEBHOOK_URL=

# Audit discrepancies are created when expected payout exceeds actual payout by this amount.
DISCREPANCY_THRESHOLD=0.00