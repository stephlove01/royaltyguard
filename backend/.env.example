# Server
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=royaltyguard
DB_USER=root
DB_PASSWORD=

# Authentication
JWT_SECRET=replace_with_a_secure_secret

# File uploads
UPLOAD_DIR=uploads

# n8n
N8N_WEBHOOK_SECRET=replace_with_n8n_webhook_secret
N8N_STATEMENT_ARTIST_ID=
N8N_BASE_URL=http://localhost:5678

# Automatic eligible-dispute delivery (legacy webhook path retained for compatibility).
# Match the Header Auth credential configured on the n8n Webhook node exactly.
N8N_DISPUTE_WEBHOOK_PATH=/webhook/royaltyguard-multiplatform-approved-send
N8N_WEBHOOK_HEADER_NAME=X-N8N-Webhook-Secret
# Backend dispute-draft generation (keep the key server-side).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Audit discrepancies are created when expected payout exceeds actual payout by this amount.
DISCREPANCY_THRESHOLD=0.00
